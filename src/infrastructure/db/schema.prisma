datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum OsType {
  LINUX
  WINDOWS
  OTHER
}

enum Environment {
  PROD
  STAGING
  DEV
  QA
}

enum LifecycleState {
  ACTIVE
  MAINTENANCE
  DISABLED
  RETIRED
}

enum HealthStatus {
  ONLINE
  DEGRADED
  UNREACHABLE
  AUTH_FAILED
  PENDING
}

enum CredentialType {
  SSH_KEY
  PASSWORD
  AGENT_TOKEN
}

enum CheckResultStatus {
  SUCCESS
  TIMEOUT
  REFUSED
  AUTH_ERROR
  ERROR
}

model Server {
  id               String          @id @default(uuid())
  name             String          @unique
  ipAddress        String          @map("ip_address")
  hostname         String?
  osType           OsType          @default(LINUX) @map("os_type")
  osVersion        String?         @map("os_version")
  environment      Environment     @default(PROD)
  connectionPort   Int             @default(22) @map("connection_port")
  technicalOwner   String?         @map("technical_owner")
  description      String?
  lifecycleState   LifecycleState  @default(ACTIVE) @map("lifecycle_state")
  healthStatus     HealthStatus    @default(PENDING) @map("health_status")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")
  lastCheckedAt    DateTime?       @map("last_checked_at")
  lastSeenAt       DateTime?       @map("last_seen_at")

  credential       ServerCredential?
  checks           ConnectivityCheck[]
  tags             ServerTag[]
  auditLogs        InventoryAuditLog[]
  logEvents        LogEvent[]
  dataFreshness    DataFreshnessState?
  logAlerts        LogAlert[]
  incidents        Incident[]
  services         ServerService[]

  @@index([environment, healthStatus, lifecycleState])
  @@index([ipAddress])
  @@map("servers")
}

model ServerCredential {
  id               String         @id @default(uuid())
  serverId         String         @unique @map("server_id")
  credentialType   CredentialType @default(SSH_KEY) @map("credential_type")
  username         String
  encryptedPayload String         @map("encrypted_payload")
  iv               String
  authTag          String         @map("auth_tag")
  keyFingerprint   String?        @map("key_fingerprint")
  createdAt        DateTime       @default(now()) @map("created_at")
  rotatedAt        DateTime       @default(now()) @map("rotated_at")

  server           Server         @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@map("server_credentials")
}

// =============================================================================
// 007 — Servicios por servidor (monitoreo de procesos/daemon)
// =============================================================================

enum ServiceStatus {
  RUNNING
  STOPPED
  ERROR
  UNKNOWN
}

model ServerService {
  id          String        @id @default(uuid())
  serverId    String        @map("server_id")
  name        String
  description String?
  status      ServiceStatus @default(UNKNOWN) @map("status")
  port        Int?          @map("port")
  endpoint    String?       @map("endpoint")
  processName String?       @map("process_name")
  lastCheckedAt DateTime?    @map("last_checked_at")
  lastResult  String?       @map("last_result")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  server      Server        @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@index([serverId, status])
  @@index([serverId, name])
  @@unique([serverId, name])
  @@map("server_services")
}

model ConnectivityCheck {
  id                String            @id @default(uuid())
  serverId          String            @map("server_id")
  eventTimestamp    DateTime          @default(now()) @map("event_timestamp")
  durationMs        Int               @map("duration_ms")
  resultStatus      CheckResultStatus @map("result_status")
  diagnosticSummary String?           @map("diagnostic_summary")

  server            Server            @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@index([serverId, eventTimestamp(sort: Desc)])
  @@map("connectivity_checks")
}

model Tag {
  id      String      @id @default(uuid())
  key     String
  value   String
  servers ServerTag[]

  @@unique([key, value])
  @@map("tags")
}

model ServerTag {
  serverId String @map("server_id")
  tagId    String @map("tag_id")

  server   Server @relation(fields: [serverId], references: [id], onDelete: Cascade)
  tag      Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([serverId, tagId])
  @@map("server_tags")
}

model InventoryAuditLog {
  id             String   @id @default(uuid())
  timestamp      DateTime @default(now())
  userId         String   @map("user_id")
  action         String
  targetServerId String?  @map("target_server_id")
  detailsDiff    Json     @map("details_diff")
  ipAddress      String?  @map("ip_address")

  server         Server?  @relation(fields: [targetServerId], references: [id], onDelete: SetNull)

  @@index([timestamp(sort: Desc)])
  @@index([targetServerId])
  @@map("inventory_audit_logs")
}

enum LogCategory {
  SYS_KERNEL
  AUTH_ACCESS
  SSH_NETWORK
  SYSTEM_SERVICE
  WEB_APP
  DATABASE
  STORAGE_HW
  BACKUP_TASK
  SECURITY_AUDIT
  AGENT_ERROR
}

enum LogSeverity {
  INFO
  WARN
  ERROR
  CRITICAL
}

enum FreshnessState {
  FRESH
  STALE
  AGENT_DISCONNECTED
  UNREACHABLE
}

enum DiagnosisStatus {
  DRAFT
  FINAL
  SUPERSEDED
}

enum ConfidenceLevel {
  LOW
  MEDIUM
  HIGH
}

enum AlertStatus {
  ACTIVE
  ACKNOWLEDGED
  RESOLVED
}

model LogCategoryModel {
  id        String      @id @default(uuid())
  code      String      @unique
  name      String
  description String?
  priority  Int         @default(5)
  events    LogEvent[]

  @@map("log_categories")
}

model LogEvent {
  id                String         @id @default(uuid())
  serverId          String?        @map("server_id")
  categoryId        String         @map("category_id")
  category          LogCategoryModel @relation(fields: [categoryId], references: [id])
  eventTimestamp    DateTime       @map("event_timestamp")
  ingestionTimestamp DateTime      @default(now()) @map("ingestion_timestamp")
  processedTimestamp DateTime?     @map("processed_timestamp")
  eventType         String?        @map("event_type")
  severity          LogSeverity    @map("severity")
  sanitizedMessage  String         @map("sanitized_message")
  rawLog            String         @map("raw_log")
  metadata          Json?          @map("metadata")
  isUntrusted       Boolean        @default(true) @map("is_untrusted")

  server            Server?        @relation(fields: [serverId], references: [id], onDelete: SetNull)
  diagnoses         IncidentDiagnosis[]
  alerts            LogAlert[]
  incidents         Incident[]

  @@index([serverId, eventTimestamp(sort: Desc)])
  @@index([categoryId, eventTimestamp(sort: Desc)])
  @@index([ingestionTimestamp(sort: Desc)])
  @@map("log_events")
}

model IncidentDiagnosis {
  id                 String   @id @default(uuid())
  generatedBy        String   @map("generated_by")
  generatedAt        DateTime @default(now()) @map("generated_at")
  observedFacts      String   @map("observed_facts")
  probableCause      String   @map("probable_cause")
  evidenceSupport    Json     @map("evidence_support")
  alternativeDiagnoses String? @map("alternative_diagnoses")
  impactPotential    String?  @map("impact_potential")
  verificationSteps  String?  @map("verification_steps")
  remediationRecommendations String? @map("remediation_recommendations")
  confidenceLevel    ConfidenceLevel @map("confidence_level")
  status             DiagnosisStatus @default(DRAFT) @map("status")

  events             LogEvent[]

  @@index([generatedAt(sort: Desc)])
  @@index([status])
  @@map("incident_diagnoses")
}

model DataFreshnessState {
  id               String         @id @default(uuid())
  serverId         String         @unique @map("server_id")
  freshnessState   FreshnessState @map("freshness_state")
  lastTelemetryAt  DateTime?      @map("last_telemetry_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  server           Server         @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@map("data_freshness_states")
}

model LogAlert {
  id               String      @id @default(uuid())
  serverId         String?     @map("server_id")
  category         LogCategory? @map("category")
  patternType      String      @map("pattern_type")
  eventCount       Int         @map("event_count")
  windowStart      DateTime    @map("window_start")
  windowEnd        DateTime    @map("window_end")
  severity         LogSeverity @map("severity")
  status           AlertStatus @default(ACTIVE) @map("status")
  acknowledgedBy   String?     @map("acknowledged_by")
  acknowledgedAt   DateTime?   @map("acknowledged_at")

  server           Server?     @relation(fields: [serverId], references: [id], onDelete: SetNull)
  events           LogEvent[]
  incidents        Incident[]

  @@index([serverId, status])
  @@index([windowStart, windowEnd])
  @@map("log_alerts")
}

// =============================================================================
// 003 — Incident Management + usuarios/RBAC (Principios IV, VI, VIII)
// =============================================================================

enum UserRole {
  SUPERADMIN
  OBSERVADOR
}

enum IncidentStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum IncidentPriority {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum IncidentCategory {
  INCIDENT_CRITICAL
  INCIDENT_MAJOR
  INCIDENT_MINOR
  INCIDENT_MAINTENANCE
}

model User {
  id           String   @id @default(uuid())
  username     String   @unique
  displayName  String?  @map("display_name")
  role         UserRole
  passwordHash String   @map("password_hash")
  isActive     Boolean  @default(true) @map("is_active")
  /// Versión de sesión: se incrementa al cambiar contraseña, rol o estado para invalidar tokens emitidos.
  sessionVersion Int    @default(0) @map("session_version")
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("users")
}

model Incident {
  id              String            @id @default(uuid())
  title           String
  description     String
  category        IncidentCategory
  priority        IncidentPriority
  status          IncidentStatus    @default(OPEN)
  serverId        String?           @map("server_id")
  alertId         String?           @map("alert_id")
  eventId         String?           @map("event_id")
  assignedTo      String?
  slaTimeoutMin   Int?              @map("sla_timeout_min")
  slaDueAt        DateTime?         @map("sla_due_at")
  slaMet          Boolean?          @map("sla_met")
  createdBy       String            @map("created_by")
  assignedAt      DateTime?         @map("assigned_at")
  startedAt       DateTime?         @map("started_at")
  resolvedAt      DateTime?         @map("resolved_at")
  closedAt        DateTime?         @map("closed_at")
  closedBy        String?           @map("closed_by")
  escalationLevel Int               @default(0) @map("escalation_level")
  escalatedAt     DateTime?         @map("escalated_at")
  rootCause       String?           @map("root_cause")
  correctiveActions String?         @map("corrective_actions")
  details         Json?
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  server          Server?             @relation(fields: [serverId], references: [id], onDelete: SetNull)
  alert           LogAlert?           @relation(fields: [alertId], references: [id], onDelete: SetNull)
  event           LogEvent?           @relation(fields: [eventId], references: [id], onDelete: SetNull)
  auditTrail      IncidentAuditLog[]

  @@index([status, priority, category])
  @@index([serverId])
  @@index([assignedTo, status])
  @@index([createdAt(sort: Desc)])
  @@map("incidents")
}

/// Auditoría append-only del ciclo de vida del incidente (Principios VI, VIII)
model IncidentAuditLog {
  id            String    @id @default(uuid())
  incidentId    String    @map("incident_id")
  userId        String    @map("user_id")
  fromStatus    String?   @map("from_status")
  toStatus      String    @map("to_status")
  action        String
  details       Json?
  createdAt     DateTime  @default(now()) @map("created_at")

  incident      Incident  @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([incidentId, createdAt(sort: Desc)])
  @@map("incident_audit_logs")
}

// =============================================================================
// 004 — Notificaciones (canales cifrados, entregabilidad, dedup)
// =============================================================================

enum ChannelType {
  EMAIL
  SLACK
  WEBHOOK
  PAGERDUTY
}

enum ChannelStatus {
  ACTIVE
  INACTIVE
}

enum DeliveryStatus {
  SENT
  FAILED
  RETRYING
}

model NotificationChannel {
  id               String        @id @default(uuid())
  type             ChannelType
  name             String        @unique
  description      String?
  status           ChannelStatus @default(ACTIVE)
  encryptedPayload String        @map("encrypted_payload")
  iv               String
  authTag          String        @map("auth_tag")
  configSummary    Json?         @map("config_summary")
  lastTestAt       DateTime?     @map("last_test_at")
  lastTestStatus   String?       @map("last_test_status")
  lastTestDetail   String?       @map("last_test_detail")
  failureCount     Int           @default(0) @map("failure_count")
  lastFailureAt    DateTime?     @map("last_failure_at")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  deliveries       NotificationDelivery[]

  @@map("notification_channels")
}

model NotificationDelivery {
  id            String         @id @default(uuid())
  channelId     String         @map("channel_id")
  dedupKey      String         @map("dedup_key")
  title         String
  message       String
  severity      String
  incidentId    String?        @map("incident_id")
  status        DeliveryStatus
  attempts      Int            @default(1)
  lastAttemptAt DateTime       @default(now()) @map("last_attempt_at")
  nextRetryAt   DateTime?      @map("next_retry_at")
  error         String?
  messageId     String?        @map("message_id")
  deliveredAt   DateTime?      @map("delivered_at")
  createdAt     DateTime       @default(now()) @map("created_at")

  channel       NotificationChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([channelId, dedupKey])
  @@index([status, nextRetryAt])
  @@index([incidentId])

  @@map("notification_deliveries")
}

// =============================================================================
// 006 — Automatización (playbooks read-only-first, human-in-the-loop, Principio V)
// =============================================================================

enum ActionKind {
  RESTART_SERVICE
  APPLY_CONFIG
  RUN_COMMAND
  NOTIFY_TEAM
  CHECK_STATE
  WAIT_SECONDS
}

enum PlaybookStatus {
  ACTIVE
  DISABLED
}

enum ExecutionStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
  CANCELLED
}

model Playbook {
  id          String         @id @default(uuid())
  name        String         @unique
  description String?
  status      PlaybookStatus @default(DISABLED)
  trigger     Json
  steps       Json
  createdBy   String         @map("created_by")
  lastRunAt   DateTime?      @map("last_run_at")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  executions  PlaybookExecution[]

  @@index([status, lastRunAt(sort: Desc)])
  @@map("playbooks")
}

model PlaybookExecution {
  id          String          @id @default(uuid())
  playbookId  String          @map("playbook_id")
  trigger     Json?
  status      ExecutionStatus @default(PENDING)
  automatic   Boolean         @default(false)
  stepsLog    Json            @map("steps_log")
  startedAt   DateTime        @default(now()) @map("started_at")
  finishedAt  DateTime?       @map("finished_at")
  error       String?

  playbook    Playbook        @relation(fields: [playbookId], references: [id], onDelete: Cascade)

  @@index([playbookId, startedAt(sort: Desc)])
  @@index([status])
  @@map("playbook_executions")
}


/// Configuraci�n global de apariencia (fila �nica con id "global").
model SystemSetting {
  id           String   @id @default("global")
  preset       String   @default("indigo")
  primaryColor String   @default("#4f46e5") @map("primary_color")
  mode         String   @default("light")
  radius       Int      @default(8)
  density      String   @default("comfortable")
  updatedBy    String?  @map("updated_by")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}
