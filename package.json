{
  "name": "nuevo-sis-monitoring",
  "version": "1.0.0",
  "private": true,
  "description": "Plataforma Empresarial de Monitoreo, Análisis de Logs y Gestión de Incidentes",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate --schema=src/infrastructure/db/schema.prisma",
    "db:migrate": "prisma migrate dev --schema=src/infrastructure/db/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "^5.21.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.453.0",
    "next": "^15.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "ssh2": "^1.15.0",
    "tailwind-merge": "^2.5.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.2",
    "@types/node": "^22.8.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ssh2": "^1.15.2",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "prisma": "^5.21.1",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3"
  }
}
