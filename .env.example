# =============================================================================
# .env.example — Plantilla de configuración de entorno
# Copia este archivo a `.env` y rellena los valores correspondientes.
# NUNCA commitear el archivo `.env` real a git.
# =============================================================================

# --- App: Criptografía y Seguridad ---
# Clave de cifrado en reposo para secretos (AES-256-GCM = 64 caracteres hex / 32 bytes).
# Generar con: `openssl rand -hex 32`
ENCRYPTION_KEY=REEMPLAZA_64_caracteres_hexadecimales

# Secreto para firma de tokens JWT/Sesión (mínimo 16 caracteres).
# Generar con: `openssl rand -base64 32`
AUTH_SECRET=REEMPLAZA_secreto_para_firmar_tokens

# --- App: Usuario Semilla Superadministrador ---
# Credenciales iniciales para la primera creación del superadministrador.
# Si se omiten, el sistema usa defaults inseguros de desarrollo.
SUPERADMIN_USER=REEMPLAZA_usuario_superadmin
SUPERADMIN_PASSWORD=REEMPLAZA_contrasena_superadmin_minimo_8_caracteres

# --- Base de Datos PostgreSQL ---
# Formato: postgresql://<usuario>:<password>@<host>:<puerto>/<nombre_db>
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nuevo_sis_dev"

# --- Servidor Web ---
PORT=3000
NODE_ENV=development

# --- Deploy: plataforma de hosting (Coolify) ---
# Usados por el subagente deploy-ops / skill agentic-microservice-deployer.
# Obtener en: Panel Coolify -> Keys & Tokens -> API Tokens
COOLIFY_API_URL=REEMPLAZA_https://tu-coolify.tu-dominio.com
COOLIFY_API_TOKEN=REEMPLAZA_coolify_api_token
COOLIFY_APP_UUID=REEMPLAZA_uuid_de_la_app

# --- MCP / Herramientas CLI ---
# Token personal de GitHub para integraciones con 'gh' o MCP de GitHub
# Obtener en: GitHub -> Settings -> Developer settings -> Personal access tokens
GITHUB_TOKEN=REEMPLAZA_github_pat
